# =============================================================================
# FRONTEND (Vite) — these are exposed in the client bundle. Only put PUBLIC
# values here (anon key, public URLs). Set these in Vercel project settings.
# =============================================================================

# Base URL of the Stripe/admin backend (no trailing slash).
# Dev default is http://localhost:4242 if unset.
VITE_API_URL=https://api.your-domain.com

# Supabase project (anon key is safe to expose; RLS protects the data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# BACKEND (backend/server.js) — SECRET. Set these on the backend host
# (Render/Railway/Fly/etc). NEVER commit real values; never prefix with VITE_.
# =============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase service-role key (bypasses RLS — keep secret, server-only).
# Note: backend reads the project URL from VITE_SUPABASE_URL as well.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public URL of the deployed frontend (used for Stripe redirect + CORS origin).
CLIENT_URL=https://your-domain.com

# Port the backend listens on (defaults to 4242).
PORT=4242
